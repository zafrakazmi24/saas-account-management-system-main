BASEPATH=
NEXT_PUBLIC_APP_URL=http://localhost:3000${BASEPATH}
NEXT_PUBLIC_DOCS_URL=https://demos.pixinvent.com/materialize-nextjs-admin-template/documentation

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
NEXTAUTH_BASEPATH=${BASEPATH}/api/auth
NEXTAUTH_URL=http://localhost:3000${BASEPATH}/api/auth
NEXTAUTH_SECRET=


API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_API_URL=${API_URL}

# -----------------------------------------------------------------------------
# Mapbox
# -----------------------------------------------------------------------------
MAPBOX_ACCESS_TOKEN=

# --- Public site / SEO ---
# Public web address of the deployed client (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# Google Search Console "HTML tag" verification code (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Contact details shown on the Contact page (used for Local SEO)
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_CITY=Your City
NEXT_PUBLIC_CONTACT_REGION=
NEXT_PUBLIC_CONTACT_COUNTRY=Your Country
# Social profile URLs (leave empty to hide)
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
